# Copy this file to .env.local for local `vercel dev`.
#
# If you provisioned Redis via Vercel's Storage tab (recommended — see
# docs/DEPLOYMENT.md), you don't need to fill these in by hand: link this
# project with `vercel link`, then run `vercel env pull .env.local` to pull
# the real values down automatically.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seeds the admin password the first time /api/admin/login runs against an
# empty database. Change it from Admin → Overview after logging in once —
# this value only matters before that first login.
ADMIN_PASSWORD_DEFAULT=askone2026
