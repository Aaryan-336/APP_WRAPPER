# Copy this file to .env.local for local `vercel dev`.

# The admin password. Not stored anywhere — checked directly against this
# value on every login. To rotate it, change this and redeploy.
ADMIN_PASSWORD=change-me-to-a-long-random-value

# Any long random string, used to sign admin session cookies (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

